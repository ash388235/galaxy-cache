<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.galaxycache</groupId>
    <artifactId>galaxy-cache-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>galaxy-cache-api</artifactId>
  <description>The client cache API apps code against (GalaxyClient, GalaxyCache, GalaxyCluster) and the provider SPI
    that the galaxy and Ignite implementations plug into. No provider code and no Ignite here.</description>
  <dependencies>
    <dependency><groupId>io.galaxycache</groupId><artifactId>galaxy-common</artifactId></dependency>
    <dependency><groupId>io.galaxycache</groupId><artifactId>galaxy-config</artifactId></dependency>
    <dependency><groupId>io.galaxycache</groupId><artifactId>galaxy-storage-api</artifactId></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <!-- test-jar: the provider contract suite, reused by every provider's tests -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <execution><goals><goal>test-jar</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
